{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // wxt 0.21 enables this by default; off until the existing index accesses are narrowed.
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*",
    "./.wxt/wxt.d.ts",
    "./.wxt/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".wxt", ".output", "./.wxt/**/*"]
}
